GATEWAY_API_HOST=0.0.0.0
GATEWAY_API_PORT=8080
GATEWAY_WEB_ORIGIN=http://localhost:5173
GATEWAY_ADMIN_PORT=5173
# Interface the dashboard port binds to. Keep 127.0.0.1 unless TLS terminates in front.
GATEWAY_ADMIN_BIND=127.0.0.1
GATEWAY_DATABASE_URL=postgresql+psycopg://asterisk_ai_gateway:change-me-before-use@postgres:5432/asterisk_ai_gateway
GATEWAY_SESSION_SECRET=replace-with-a-long-random-secret
GATEWAY_API_KEY_PEPPER=replace-with-a-separate-long-random-secret
GATEWAY_BOOTSTRAP_EMAIL=owner@example.com
GATEWAY_BOOTSTRAP_PASSWORD=replace-before-use
GATEWAY_COOKIE_SECURE=false
GATEWAY_BROWSER_SESSION_MAX_AGE=28800
GATEWAY_TOKEN_RATE_LIMIT_PER_MINUTE=60
POSTGRES_DB=asterisk_ai_gateway
POSTGRES_USER=asterisk_ai_gateway
POSTGRES_PASSWORD=change-me-before-use
REDIS_URL=redis://redis:6379/0
ASTERISK_ARI_BASE_URL=http://asterisk.local:8088/ari
ASTERISK_ARI_USERNAME=replace-me
ASTERISK_ARI_PASSWORD=replace-me
AUDIOSOCKET_PORT=8090
AUDIOSOCKET_ADVERTISE_HOST=api
GATEWAY_MEDIA_TRANSPORT=audiosocket
EXTERNAL_MEDIA_HOST=0.0.0.0
EXTERNAL_MEDIA_ADVERTISE_HOST=api
